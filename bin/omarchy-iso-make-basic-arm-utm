#!/bin/bash

set -Eeuo pipefail
trap 'printf "ERROR: basic ARM ISO build wrapper failed at %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

UTMCTL=/Applications/UTM.app/Contents/MacOS/utmctl
vm_name=Llamarchy-ARM-ISO-Builder
vm_id=""
ssh_host=""
ssh_port=22
cache_dir="${LLAMARCHY_ARM_CACHE:-${HOME}/Library/Caches/Llamarchy/utm-arm}"
guest_source=/root/omarchy-iso-arm
guest_cache=/var/cache/llamarchy/utm-arm
force_rebuild=0
check_builder=0

usage() {
  cat <<'USAGE'
Usage: omarchy-iso-make-basic-arm-utm [options]

Synchronize this checkout into the native AArch64 UTM builder, build the plain
Arch Linux ARM ISO from the persistent package cache, and retain the resulting
ISO and updated package cache on the host.

Options:
  --vm NAME           Builder VM name (default: Llamarchy-ARM-ISO-Builder)
  --vm-id UUID        Builder VM UUID
  --ssh-host HOST     Builder SSH endpoint (default: resolve IPv4 from UTM MAC)
  --ssh-port PORT     Builder SSH port (default: 22)
  --cache-dir DIR     Persistent ARM development cache
  --check-builder     Verify UUID, MAC, IPv4, hostname, and architecture
  --rebuild           Rebuild even when the cached ISO inputs match
  -h, --help          Show this help
USAGE
}

while (($#)); do
  case $1 in
    --vm) vm_name="$2"; shift 2 ;;
    --vm-id) vm_id="$2"; shift 2 ;;
    --ssh-host|--guest-host) ssh_host="$2"; shift 2 ;;
    --ssh-port) ssh_port="$2"; shift 2 ;;
    --cache-dir) cache_dir="$2"; shift 2 ;;
    --check-builder) check_builder=1; shift ;;
    --rebuild) force_rebuild=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

ssh_host_override=$ssh_host

[[ $(uname -s) == "Darwin" ]] || { echo "ERROR: this wrapper runs on macOS" >&2; exit 1; }
[[ -x $UTMCTL ]] || { echo "ERROR: UTM CLI is unavailable at $UTMCTL" >&2; exit 1; }
[[ $ssh_port =~ ^[0-9]+$ ]] && (( ssh_port > 0 && ssh_port < 65536 )) || { echo "ERROR: invalid builder SSH port: $ssh_port" >&2; exit 1; }
for command in git rsync shasum ssh; do
  command -v "$command" >/dev/null || { echo "ERROR: required host command is unavailable: $command" >&2; exit 1; }
done
mkdir -p "$cache_dir/pacman/pkg" "$cache_dir/basic-iso/release"

source_root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
if (( check_builder == 0 )); then
  input_files=(
    "$source_root/builder/basic-live.packages.aarch64"
    "$source_root/builder/build-basic-arm-iso.sh"
    "$source_root/builder/install-basic-arm.sh"
    "$source_root/configs/pacman-online-aarch64.conf"
  )
  for input_file in "${input_files[@]}"; do
    [[ -s $input_file ]] || { echo "ERROR: basic ISO input is unavailable: $input_file" >&2; exit 1; }
  done
  input_hash=$(
    {
      git -C "$source_root/archiso" rev-parse HEAD
      shasum -a 256 "${input_files[@]}"
    } | shasum -a 256 | awk '{print $1}'
  )
  input_stamp="$cache_dir/basic-iso/release/.inputs.sha256"
  latest_iso=$(find "$cache_dir/basic-iso/release" -maxdepth 1 -type f -name 'archlinuxarm-basic-*-aarch64.iso' -print | sort | tail -1)
  cached_input_hash=""
  if [[ -s $input_stamp ]]; then
    cached_input_hash=$(<"$input_stamp")
  fi
  if (( force_rebuild == 0 )) && [[ -s $latest_iso && $cached_input_hash == "$input_hash" ]]; then
    echo "Reusing input-matched basic Arch Linux ARM ISO: $latest_iso"
    shasum -a 256 "$latest_iso"
    exit 0
  fi
fi

if [[ -z $vm_id ]]; then
  vm_inventory=$(osascript \
    -e 'tell application "UTM"' \
    -e 'set vmLines to ""' \
    -e 'repeat with vmItem in every virtual machine' \
    -e 'set vmLines to vmLines & (id of vmItem) & tab & (name of vmItem) & linefeed' \
    -e 'end repeat' \
    -e 'return vmLines' \
    -e 'end tell')
  vm_id=$(awk -F '\t' -v expected="$vm_name" '$2 == expected { print $1 }' <<<"$vm_inventory")
  [[ -n $vm_id ]] || { echo "ERROR: UTM builder VM is unavailable: $vm_name" >&2; exit 1; }
fi
[[ $vm_id =~ ^[0-9A-Fa-f-]{36}$ ]] || { echo "ERROR: invalid UTM builder UUID: $vm_id" >&2; exit 1; }

normalize_mac() {
  local raw_mac=$1
  local normalized=""
  local octet
  local separator=""
  local saved_ifs=$IFS
  IFS=:
  set -- $raw_mac
  IFS=$saved_ifs
  for octet; do
    printf -v octet '%x' "$((16#$octet))"
    normalized+="$separator$octet"
    separator=:
  done
  printf '%s\n' "$normalized"
}

lookup_ipv4_by_mac() {
  local expected_mac=$1
  local candidate_ip
  local candidate_mac
  while read -r candidate_ip candidate_mac; do
    if [[ $(normalize_mac "$candidate_mac") == "$expected_mac" ]]; then
      printf '%s\n' "$candidate_ip"
      return 0
    fi
  done < <(arp -an | awk '$2 ~ /^\([0-9.]+\)$/ && $4 ~ /^([[:xdigit:]]+:){5}[[:xdigit:]]+$/ { gsub(/[()]/, "", $2); print $2, $4 }')
  return 1
}

builder_mac_display=$(osascript \
  -e 'tell application "UTM"' \
  -e "set targetVM to virtual machine id \"$vm_id\"" \
  -e 'set vmConfig to configuration of targetVM' \
  -e 'set netConfig to item 1 of network interfaces of vmConfig' \
  -e 'return address of netConfig' \
  -e 'end tell')
[[ $builder_mac_display =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || { echo "ERROR: builder MAC address is unavailable" >&2; exit 1; }
builder_mac=$(normalize_mac "$builder_mac_display")

vm_status=$(osascript \
  -e 'tell application "UTM"' \
  -e "set targetVM to virtual machine id \"$vm_id\"" \
  -e 'return status of targetVM as text' \
  -e 'end tell')
if [[ $vm_status != "started" ]]; then
  "$UTMCTL" start "$vm_id" 2>/dev/null || true
fi
ssh_builder=()
builder_ready() {
  local architecture
  local guest_hostname
  local guest_macs
  local identity
  local remaining
  identity=$("${ssh_builder[@]}" 'uname -m; hostname; cat /sys/class/net/*/address' 2>/dev/null) || return 1
  architecture=${identity%%$'\n'*}
  remaining=${identity#*$'\n'}
  guest_hostname=${remaining%%$'\n'*}
  guest_macs=${remaining#*$'\n'}
  [[ $architecture == "aarch64" ]] || return 1
  [[ $guest_hostname == "llamarchy-arm-builder" ]] || return 1
  grep -Fxi "$builder_mac_display" <<<"$guest_macs" >/dev/null
}
for attempt in {1..60}; do
  if [[ -z $ssh_host ]]; then
    ssh_host=$(lookup_ipv4_by_mac "$builder_mac" || true)
  fi
  if [[ -n $ssh_host ]]; then
    ssh_builder=(
      ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=accept-new
      -o "HostName=$ssh_host" -o "Port=$ssh_port" -o HostKeyAlias=llamarchy-arm-builder-ipv4
      root@llamarchy-arm-builder
    )
  fi
  if ((${#ssh_builder[@]})) && builder_ready; then
    break
  fi
  if [[ -z $ssh_host_override ]]; then
    ssh_host=""
  fi
  (( attempt < 60 )) || { echo "ERROR: native ARM builder SSH did not become ready" >&2; exit 1; }
  sleep 2
done
if (( check_builder )); then
  echo "Builder verified: vm=$vm_id mac=$builder_mac_display ipv4=$ssh_host hostname=llamarchy-arm-builder arch=aarch64"
  exit 0
fi

ssh_transport="ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o HostName=$ssh_host -o Port=$ssh_port -o HostKeyAlias=llamarchy-arm-builder-ipv4"

rsync -a --delete --exclude .git --exclude __pycache__ --exclude '*.pyc' --exclude release --exclude test-runs \
  -e "$ssh_transport" "$source_root/" "root@llamarchy-arm-builder:$guest_source/"
"${ssh_builder[@]}" "mkdir -p '$guest_cache/pacman/pkg' '$guest_cache/basic-iso/release'"
rsync -a -e "$ssh_transport" "$cache_dir/pacman/pkg/" \
  "root@llamarchy-arm-builder:$guest_cache/pacman/pkg/"

sync_guest_cache() {
  local build_status=$1
  local sync_status=0 command_status

  trap - EXIT
  set +e
  rsync -a -e "$ssh_transport" \
    "root@llamarchy-arm-builder:$guest_cache/pacman/pkg/" "$cache_dir/pacman/pkg/"
  command_status=$?
  (( command_status == 0 )) || sync_status=$command_status
  rsync -a -e "$ssh_transport" \
    "root@llamarchy-arm-builder:$guest_cache/basic-iso/release/" "$cache_dir/basic-iso/release/"
  command_status=$?
  (( command_status == 0 )) || sync_status=$command_status
  set -e

  if (( build_status != 0 )); then
    exit "$build_status"
  elif (( sync_status != 0 )); then
    exit "$sync_status"
  fi
}
trap 'sync_guest_cache $?' EXIT

"${ssh_builder[@]}" \
  "cd '$guest_source' && OMARCHY_ARM_ARTIFACT_CACHE='$guest_cache' ./builder/build-basic-arm-iso.sh"
sync_guest_cache 0

latest_iso=$(find "$cache_dir/basic-iso/release" -maxdepth 1 -type f -name 'archlinuxarm-basic-*-aarch64.iso' -print | sort | tail -1)
[[ -s $latest_iso ]] || { echo "ERROR: basic ARM ISO build produced no artifact" >&2; exit 1; }
printf '%s\n' "$input_hash" >"$input_stamp"

echo
echo "Basic Arch Linux ARM ISO: $latest_iso"
shasum -a 256 "$latest_iso"
